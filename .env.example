# StrtOS Centralized Environment Configuration Template
# Copy this file to .env or .env.development / .env.production

# APPLICATION
APP_NAME=StrtOS
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# DATABASE (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strtos_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/strtos_db

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# JWT SECURITY
JWT_SECRET_KEY=strtos-enterprise-secret-key-change-in-prod-2026
JWT_REFRESH_SECRET=strtos-enterprise-refresh-secret-key-change-in-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI PROVIDERS (LLM ROUTER)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# TOOLS
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_MAPS_API_KEY=
