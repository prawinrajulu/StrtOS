# StrtOS Enterprise Environment Configuration Template
# Copy this file to .env or .env.development / .env.production

# APPLICATION
APP_NAME=StrtOS
APP_ENV=development
DEBUG=True
API_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# DATABASE (Supabase PostgreSQL / PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/postgres

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# JWT SECURITY
JWT_SECRET_KEY=change_this_to_a_secure_jwt_secret_in_production
JWT_REFRESH_SECRET=change_this_to_a_secure_refresh_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI PROVIDERS (LLM ROUTER)
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
QWEN_API_KEY=your_qwen_api_key

# TOOLS
FIRECRAWL_API_KEY=your_firecrawl_api_key
TAVILY_API_KEY=your_tavily_api_key
SERPER_API_KEY=your_serper_api_key
GOOGLE_PAGESPEED_API_KEY=your_pagespeed_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# FRONTEND
VITE_API_BASE_URL=http://localhost:8000
