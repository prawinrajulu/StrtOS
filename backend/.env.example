# App Settings
APP_NAME="StrtOS Backend"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="strtos_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="strtos_db"
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/strtos_db"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_URL="redis://localhost:6379/0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
