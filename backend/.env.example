# StrtOS Backend Environment Configuration Template
# Copy this file to backend/.env

# APPLICATION
APP_NAME=StrtOS
APP_ENV=production
DEBUG=False
API_PREFIX=/api/v1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["https://strtos.app","http://localhost:5173"]

# DATABASE
DATABASE_HOST=aws-0-ap-south-1.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_NAME=postgres
DATABASE_USER=postgres.your_project_ref
DATABASE_PASSWORD=your_supabase_password
DATABASE_URL=postgresql+asyncpg://postgres.your_project_ref:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# REDIS
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# JWT SECURITY
JWT_SECRET_KEY=change_this_to_a_secure_jwt_secret_in_production
JWT_REFRESH_SECRET=change_this_to_a_secure_refresh_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI PROVIDERS
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# TOOLS
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_MAPS_API_KEY=
